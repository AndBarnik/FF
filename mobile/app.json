{
  "expo": {
    "name": "FF Messenger",
    "slug": "ff-messenger",
    "version": "0.1.0",
    "scheme": "ffmessenger",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": ["expo-router", "expo-secure-store"],
    "ios": { "supportsTablet": false, "bundleIdentifier": "com.ff.messenger" },
    "android": { "package": "com.ff.messenger" },
    "extra": { "apiUrl": "http://localhost:3000" }
  }
}
